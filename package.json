{
  "name": "ast-refactor-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server providing AST-safe code inspection and deterministic, scope-bounded refactoring using Tree-sitter.",
  "main": "dist/server.js",
  "type": "module",
  "bin": {
    "ast-refactor-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tree-sitter",
    "ast",
    "refactoring"
  ],
  "author": "",
  "license": "MIT"
}
